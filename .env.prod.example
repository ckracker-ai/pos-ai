# Copiar a .env.prod (no commitear). Todos los secretos deben ser únicos y >= 32 chars.
# docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# Después del primer arranque de un volumen MySQL ya existente:
#   docker exec pos-ai-db-mysql bash /docker-entrypoint-initdb.d/zz-least-privilege.sh

APP_VERSION=2.0.2026-09-15
NODE_ENV=production
COOKIE_SECURE=true

APP_DOMAIN=pos-ai.cl
API_DOMAIN=api.pos-ai.cl
FRONTEND_PUBLIC_URL=https://pos-ai.cl
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_VERSION=2.0.2026-09-15
CORS_ORIGINS=https://pos-ai.cl,https://www.pos-ai.cl

INTERNAL_API_KEY=replace-with-32-plus-unique-internal-key
JWT_SECRET=replace-with-32-plus-unique-jwt-secret
JWT_REFRESH_SECRET=replace-with-32-plus-unique-refresh-secret
FIELD_ENCRYPTION_KEY=replace-with-32-plus-unique-field-key

REDIS_PASSWORD=replace-with-32-plus-unique-redis-password
REDIS_URL=redis://:replace-with-32-plus-unique-redis-password@pos-ai-redis:6379

MYSQL_DATABASE=pos-ai-db
MYSQL_USER=usr_pos_core
MYSQL_PASSWORD=replace-with-unique-mysql-core-password
MYSQL_READONLY_USER=usr_pos_readonly
MYSQL_READONLY_PASSWORD=replace-with-unique-mysql-readonly-password
MYSQL_ROOT_PASSWORD=replace-with-unique-mysql-root-password
DB_NAME=pos-ai-db
DB_USER=usr_pos_core
DB_PASSWORD=replace-with-unique-mysql-core-password

SUBSCRIPTION_WEBHOOK_SECRET=replace-with-32-plus-unique-sub-webhook
PAYMENT_GATEWAY_WEBHOOK_SECRET=replace-with-32-plus-unique-pay-gateway
PAYMENT_WEBHOOK_HMAC_SECRET=replace-with-32-plus-unique-pay-hmac
PAYMENT_CHECKOUT_TOKEN_SECRET=replace-with-32-plus-unique-checkout
PAYMENT_WEBHOOK_SECRET=replace-with-32-plus-unique-assistant-webhook

# Webpay integración: no usar secrets de muestra de Transbank en prod.
PAYMENT_PROVIDER=WEBPAY
WEBPAY_MODE=integration
WEBPAY_COMMERCE_CODE=
WEBPAY_API_SECRET=
WEBPAY_API_BASE_URL=https://webpay3gint.transbank.cl

PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
BOOTSTRAP_PLATFORM_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_DEMO_USERS_ENABLED=false
